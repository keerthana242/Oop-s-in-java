import java.util.Scanner;
class Employee{
    String name;
    int salary;
    void display(){
       System.out.println("employee1_details"+" "+name+" "+salary);
    }   
}
public class Main{    
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        Employee e1 = new Employee();
        e1.name= sc.next();
        e1.salary=sc.nextInt();
        e1.display();
   }
}
